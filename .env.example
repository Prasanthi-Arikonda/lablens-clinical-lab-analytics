# LabLens configuration template
# 1) Copy this file and name the copy .env  (in the same project folder)
# 2) Replace the placeholder values with your own settings
# 3) Never share or submit your real .env file

# MySQL - operational database (Module 1)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=clinical_lab_ops

# MongoDB - document database (Module 2)
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=clinical_lab_docs

# PostgreSQL - analytics warehouse (Module 3)
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=clinical_lab_dw
PG_USER=your_postgres_username_here
PG_PASSWORD=

# Read-only account used by the AI (created by 03_postgres_warehouse_ddl.sql)
PG_READONLY_USER=lab_ai_reader
PG_READONLY_PASSWORD=

# Local AI (Ollama)
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
